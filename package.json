{
  "name": "aws-cloudfront-sign",
  "version": "3.0.2",
  "description": "Utility module for signing AWS CloudFront URLs",
  "keywords": [
    "aws",
    "CloudFront",
    "signed URL"
  ],
  "bugs": {
    "url": "https://github.com/jasonsims/aws-cloudfront-sign/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jasonsims/aws-cloudfront-sign.git"
  },
  "funding": "https://ko-fi.com/jzimz",
  "license": "MIT",
  "author": "Jason Sims <sims.jrobert@gmail.com>",
  "contributors": [
    {
      "name": "Matt Palmerlee"
    }
  ],
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.esm.js",
  "types": "./dist/cjs/index.d.ts",
  "typesVersions": {
    "*": {
      "types": [
        "./dist/cjs/types.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.esm.d.ts",
        "default": "./dist/esm/index.esm.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/esm/types.d.ts",
        "default": "./dist/esm/types.js"
      },
      "require": {
        "types": "./dist/cjs/types.d.ts",
        "default": "./dist/cjs/types.js"
      }
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:pkg",
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "build:esm": "tsc --project tsconfig.esm.json",
    "build:pkg": "node ./scripts/write-dist-package-json.mjs",
    "check:package": "publint && attw --pack .",
    "clean": "rimraf ./dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "moment": "^2.31.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}

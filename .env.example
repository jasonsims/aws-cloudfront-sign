# CloudFront smoke tests for `npm run test:integration`.
# Copy to .env (gitignored) and fill in all three; the tests are skipped
# while any of them is empty. Values already set in the environment win.

# A private object served by a distribution whose cache behavior has
# "Restrict viewer access" on with a trusted key group, e.g.
# https://d111111abcdef8.cloudfront.net/smoke-test.txt (no query string).
CF_URL=
# CloudFront console > Key management > Public keys > ID, e.g. K2JCJMDEHXQW5F
CF_KEYPAIR_ID=
# The matching private key in PEM form, in double quotes; it may span lines:
# CF_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----"
CF_PRIVATE_KEY=

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Oxlint's default plugins plus vitest, with its bug-finding categories as
  // errors. Formatting belongs to Prettier and style rules are left out.
  "plugins": ["typescript", "unicorn", "oxc", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": ["dist/", "coverage/"],
  "overrides": [
    {
      // The usual typescript-eslint "recommended type-checked" guarantees.
      // Oxlint files these under `pedantic`/`restriction`, so they are opted
      // into one by one rather than enabling those whole categories.
      "files": ["**/*.{ts,mts,cts}"],
      "rules": {
        // No escape hatches out of the type system
        "typescript/ban-ts-comment": "error",
        "typescript/no-explicit-any": "error",
        "typescript/no-empty-object-type": "error",
        "typescript/no-unsafe-function-type": "error",
        "typescript/no-unsafe-argument": "error",
        "typescript/no-unsafe-assignment": "error",
        "typescript/no-unsafe-call": "error",
        "typescript/no-unsafe-member-access": "error",
        "typescript/no-unsafe-return": "error",
        // Errors and promises
        "typescript/only-throw-error": "error",
        "typescript/prefer-promise-reject-errors": "error",
        "typescript/no-misused-promises": "error",
        "typescript/require-await": "error",
        "typescript/no-deprecated": "error"
      }
    },
    {
      // tsc only checks src/, so scripts, examples and integration tests rely
      // on the linter to catch undefined names.
      "files": ["**/*.{js,mjs,cjs}"],
      "env": { "builtin": true, "node": true },
      "rules": {
        "no-undef": "error"
      }
    }
  ]
}
